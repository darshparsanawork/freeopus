# Copy this file to .env before running (run.sh / run.ps1 do this for you
# automatically if .env doesn't exist yet).
#
# Everything here can also be set later from the in-app Settings panel —
# these are just optional defaults so a first run can work headlessly.

# Which provider to use for AI moment-picking: "openrouter" or "gemini"
LLM_PROVIDER=openrouter

# Get a key at https://openrouter.ai/keys (one key, any model)
OPENROUTER_API_KEY=

# Or use Google Gemini directly: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Web port the dashboard listens on
PORT=8000
